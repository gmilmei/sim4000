                       ;    (otherwise move a whole portion)
h3:                    ; start of move-table:
     dl  w0  x2+30     ;
     ds  w0  x1+30     ;
     dl  w0  x2+26     ;
     ds  w0  x1+26     ;
     dl  w0  x2+22     ;
