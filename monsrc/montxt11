     al  w0    -f51-1  ;
     la. w0     d1.+f3 ;    newkey := key.work;
     al  w3    -1      ;    oldkey := -1;

g2:                    ; get maincat claim addr:
     ds. w2     h1.    ;    save (entries, slices);
