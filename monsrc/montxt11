;   last of chaintable.
; now try between first and last of chaintable
g16:                   ; test from first of chaintable:
     rl. w2     d4.    ;
     rx. w2     h4.    ;    minslice := first of chaintable;
     se. w2    (h4.)   ;    if not already tried from first of chaintable then
