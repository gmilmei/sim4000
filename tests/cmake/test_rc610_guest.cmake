cmake_minimum_required(VERSION 3.20)
# Each run owns a new output; never erase a previous test's printer file.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
file(SHA256 "${MONITOR}" monitor_before)
file(SHA256 "${DISK}" disk_before)
set(host)
if(SOURCE)
    file(SHA256 "${SOURCE}" source_before)
    file(SHA256 "${EXAMPLE}" example_before)
    if(NOT source_before STREQUAL example_before)
        message(FATAL_ERROR "Printer source fixture differs from the shipped tutorial example")
    endif()
    set(host "${OUTPUT}/rc610-${token}.host")
    file(MAKE_DIRECTORY "${host}")
    configure_file("${SOURCE}" "${host}/print_source.alg" COPYONLY)
endif()
execute_process(COMMAND "${BINARY}" ${MODE} "${MONITOR}" "${DISK}"
    "${OUTPUT}/rc610-${token}.txt" ${host} RESULT_VARIABLE result)
file(SHA256 "${MONITOR}" monitor_after)
file(SHA256 "${DISK}" disk_after)
if(NOT monitor_before STREQUAL monitor_after OR NOT disk_before STREQUAL disk_after)
    message(FATAL_ERROR "RC610 guest check changed base media")
endif()
if(SOURCE)
    file(SHA256 "${SOURCE}" source_after)
    file(SHA256 "${EXAMPLE}" example_after)
    if(NOT source_before STREQUAL source_after OR NOT example_before STREQUAL example_after)
        message(FATAL_ERROR "RC610 guest check changed source inputs")
    endif()
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "RC610 guest check failed: ${result}")
endif()
